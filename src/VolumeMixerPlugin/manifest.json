{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.diegofdezab.volume-mixer",
  "name": "Volume Mixer",
  "version": "1.0.0",
  "description": "Windows volume mixer for Macro Deck: see the default output and microphone, and switch between them from a button.",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/VolumeMixerPlugin.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  },
  "publisher": {
    "name": "DiegoFdezAb"
  },
  "license": "MIT",
  "compatibility": {
    "macroDeck": ">=3.0.0-0"
  }
}